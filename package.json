{
  "name": "markdown-wiki",
  "version": "1.0.0",
  "description": "Turn a folder of Markdown files into a searchable, linkable personal wiki",
  "author": "katogatogato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katogatogato/markdown-wiki"
  },
  "keywords": [
    "wiki",
    "markdown",
    "static-site",
    "backlinks",
    "knowledge-base",
    "obsidian-like"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "examples/"
  ],
  "bin": {
    "markdown-wiki": "./bin/markdown-wiki"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "marked": "^12.0.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
